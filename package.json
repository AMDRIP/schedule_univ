{
  "name": "schedule-system-app",
  "version": "6000.2310.2026-rc.1",
  "displayVersion": "6000.2310.2026rc1",
  "releaseType": "кандидат в релиз",
  "description": "Веб-приложение для управления и просмотра расписаний занятий в высшем учебном заведении. Позволяет администраторам управлять данными, методистам составлять расписания (в том числе с помощью ИИ), а студентам и преподавателям просматривать актуальное расписание.",
  "main": "main.js",
  "scripts": {
    "test": "node tests/run.cjs",
    "test:ui": "node tests/ui.cjs",
    "test:performance": "node tests/parallelBenchmark.cjs",
    "test:iteration": "node tests/oneIterationBenchmark.cjs",
    "test:packaged": "node tests/packagedWorker.cjs",
    "start:api": "node integrations/server.cjs",
    "start:bot": "node integrations/telegramBot.cjs",
    "typecheck": "tsc --noEmit --pretty false",
    "start": "electron .",
    "prestart": "npm run build:js && npm run build:css",
    "build": "npm run build:js && npm run build:css",
    "dist": "npm run build && electron-builder --win --publish never",
    "test:security": "node tests/security.cjs",
    "test:release": "node tests/release.cjs",
    "build:css": "tailwindcss -i ./TWD/input.css -o ./TWD/output.css",
    "watch:css": "tailwindcss -i ./TWD/input.css -o ./TWD/output.css --watch",
    "build:js": "node esbuild.config.js",
    "rebuild": "electron-builder install-app-deps",
    "build:native": "node-gyp rebuild"
  },
  "author": "Дмитрий Власов",
  "license": "ISC",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@electron/asar": "^4.0.0",
    "js-yaml": "^4.1.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^3.4.3"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "bindings": "^1.5.0",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "node-addon-api": "^7.1.0",
    "react": "^19.2.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.1",
    "semver": "^7.7.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "gypfile": true,
  "overrides": { "postcss-selector-parser": "7.1.6" },
  "build": {
    "productName": "Расписание ВУЗ",
    "appId": "com.schedule-system.app",
    "publish": [
      {
        "provider": "github",
        "owner": "AMDRIP",
        "repo": "schedule_univ",
        "channel": "rc",
        "releaseType": "prerelease"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "integrations/*.cjs",
      "integrations/.env.example",
      "docs/PUBLICATION_API.md",
      "docs/STABILITY.md",
      "SECURITY.md",
      "index.html",
      "dist/*.js",
      "TWD/output.css",
      "icon.svg",
      "1631285.ico",
      "CHANGELOG.md",
      "package.json",
      "native/build/Release/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "1631285.ico",
      "artifactName": "schedule-system-app-setup-${version}.${ext}",
      "fileAssociations": [{ "ext": "schd", "name": "University schedule project", "description": "Проект расписания ВУЗа", "role": "Editor" }]
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "installerLanguages": ["ru_RU", "en_US"],
      "language": "1049",
      "installerIcon": "1631285.ico",
      "uninstallerIcon": "1631285.ico",
      "allowElevation": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Расписание ВУЗ"
    },
    "mac": {
      "target": "dmg",
      "icon": "1631285.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "1631285.ico"
    }
  }
}
